# Upload filter for `railway up`.
#
# IMPORTANT: Railway's uploader does NOT read .dockerignore. It walks the tree
# using .gitignore + this file, plus a hardcoded exclusion of .git and
# node_modules. .dockerignore applies later, to the BuildKit build itself.
# Two filters, two stages -- both are required.
#
# The upload is rejected with HTTP 413 above roughly 45MB, and the tracked tree
# is ~292MB raw (Documentation alone is 150MB), so these exclusions are load
# bearing, not cosmetic. Keep in sync with .dockerignore.
#
# Do NOT exclude docker/release/seed/ -- the demo database dump must ship.

# Version control / CI
.gitattributes
.github
.railway

# Dependencies -- rebuilt inside the image
vendor
ccdaservice/packages/*/node_modules

# Documentation (~150MB)
Documentation
docs

# Tests and quality tooling
tests
ci
.phpstan
tmp-phpstan
phpunit*.xml
phpstan.neon.dist
rector.php
rector-*.php
phpcs.xml.dist
semgrep.yaml
run-semgrep.sh
codecov.yml
jest.config.js
eslint.config.mjs
.stylelintrc.json
.stylelintignore
.pre-commit-config.yaml
.codespell*
.coderabbit.yaml
.dclintrc.yaml
.hadolint.yaml
.shellcheckrc
.editorconfig
.composer-require-checker.json

# Build scratch
.webpack-cache

# Other docker contexts (the deploy image only needs docker/release/)
docker/binary
docker/container_benchmarking
docker/development-easy
docker/development-easy-light
docker/development-easy-redis
docker/development-insane
docker/dockerhub
docker/flex
docker/production

# Agent/tooling config
