# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=
# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=


# Railway project reference (for `railway link --project <id>` etc.), not
# used by local docker-compose. Kept as plain values -- no Railway `${{...}}`
# template syntax here, since Docker Compose's own .env parser chokes on it.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

OPENEMR__COPILOT_API_KEY=


OPENEMR__LANGFUSE_SECRET_KEY=
OPENEMR__LANGFUSE_PUBLIC_KEY=
OPENEMR__LANGFUSE_BASE_HOST=



OPENEMR__VOYAGE_API_KEY=
